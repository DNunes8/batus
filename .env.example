# Copy this file to .env.local and fill in the values.
#
# Where each value lives in production:
#   NEXT_PUBLIC_*  are compiled into the browser bundle, so the BUILD machine
#                  needs them — they must be in .env.local before `npm run
#                  deploy`. They are public by design (Supabase RLS is what
#                  protects the data), and the same two values are already
#                  visible in the site's JavaScript.
#   everything else is a Cloudflare secret (`npx wrangler secret list` to see
#                  them) and is read at runtime, so it does NOT have to be
#                  right on the build machine. If it IS present at build time
#                  the adapter also bakes it into the bundle as a fallback —
#                  harmless, but after rotating a key, redeploy so the stale
#                  copy goes away.

# --- Supabase: Project Settings -> API ---

# Project URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key (SERVER ONLY — never import into client components)
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) — optional. Without these, app emails are skipped
# (logged, never error). Get the key at resend.com -> API Keys.
# RESEND_FROM must be on a domain verified in Resend (e.g. batusboxe.com).
RESEND_API_KEY=
RESEND_FROM="Batus <noreply@batusboxe.com>"

# --- Site URL — used to build links inside outgoing emails. Optional; falls
# back to https://batusboxe.com. Only set it when running against a different
# domain (a preview deployment, or a rename).
NEXT_PUBLIC_SITE_URL=

# --- Cron secret — shared between the Cloudflare secret and the GitHub Actions
# secret. Protects /api/cron/payment-reminders so only the scheduled job can
# fire it. Any long random string; must match in both places.
CRON_SECRET=
